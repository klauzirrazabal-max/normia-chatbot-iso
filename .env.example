# ---------- App ----------
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- Base de datos (Postgres + pgvector via docker compose) ----------
# Driver psycopg3. Si usas Supabase/Neon/Railway, reemplaza solo esta cadena.
DATABASE_URL=postgresql+psycopg://normia:normia_pass@localhost:5432/normia_db

# ---------- Proveedor de LLM ----------
# Cualquier backend con API compatible OpenAI: ollama | groq | openai-compatible
LLM_PROVIDER=ollama

# Ollama local (por defecto): sin API key, sin limites, sin internet.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.8:27b-mlx
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Cortacircuitos: tras N fallos seguidos se falla rapido durante el enfriamiento,
# en vez de que cada usuario espere el timeout completo con el backend caido.
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
LLM_TEMPERATURE=0.2
# Profundidad de razonamiento: low | medium | high.
# OJO: Ollama IGNORA este campo (medido). Sirve para otros proveedores.
LLM_REASONING_EFFORT=

# Modo rapido: desactiva el razonamiento del modelo. Solo con Ollama, porque
# usa su API nativa (/api/chat con think=false) en vez del endpoint OpenAI.
# Medido: ~10x mas rapido. Verifica la calidad con benchmark_models.py antes
# de activarlo en produccion.
LLM_DISABLE_THINKING=false

# Para cambiar a Groq, solo reemplaza las cuatro lineas de arriba por:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
# Ojo: free tier de Groq = 6.000 tokens/minuto. RAG con citas lo consume rapido.

# ---------- Embeddings (locales, sin costo ni API key) ----------
# bge-m3 -> 1024 dimensiones. Si cambias de modelo, ajusta EMBEDDING_DIM
# y vuelve a correr la migracion: la columna vector(N) debe coincidir.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- RAG ----------
RAG_TOP_K=4
# Distancia coseno maxima aceptada (0 = identico, 2 = opuesto).
# Por encima de este valor el chunk se descarta y el guardrail escala a Calidad.
# Calibralo con: uv run python scripts/calibrate_threshold.py
RAG_MAX_DISTANCE=0.49
RAG_RELATIVE_MARGIN=0.08

# Corte RELATIVO: descarta fragmentos mucho mas lejanos que el mejor match de
# la consulta. El umbral absoluto decide SI se responde; este decide CUALES
# fragmentos sirven, y evita que tres chunks de ruido acompanen al bueno.

# ---------- Widget web ----------
WIDGET_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000,http://127.0.0.1:5500

# ---------- Tenant de la demo ----------
DEFAULT_TENANT_ID=empresa-demo-iso
