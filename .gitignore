# --- Secretos y entorno ---
.env
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Sistema ---
.DS_Store

# --- DOCUMENTACION CONTROLADA DEL CLIENTE ---
#
# Un SGC contiene procedimientos internos, organigramas y politicas de una
# empresa real. NADA de eso puede acabar en un repositorio publico, ni los PDFs
# ni lo que se derive de ellos.
#
# Es la razon de que este proyecto corra el modelo en local: si los documentos no
# salen de la maquina, tampoco pueden salir por git.
# Lo que sube un usuario por el panel. Son documentos del cliente y no tienen
# nada que hacer en el repositorio.
data/uploads/

data/knowledge_base/*/*.pdf
data/knowledge_base/*/metadata.csv

# El FAQ generado reproduce el contenido de las clausulas: plazos, responsables,
# flujos de trabajo. Mismo criterio que los PDFs.
data/faq/*

# El dataset de fine-tuning lleva el texto INTEGRO de las clausulas dentro de
# cada prompt -- es la copia mas completa del SGC que produce el proyecto.
# Se regenera con scripts/build_finetune_dataset.py; no se versiona.
data/finetune/*

# EXCEPCION, y es la que hace reproducible el proyecto: el FAQ y el dataset del
# corpus SINTETICO si viajan. Sin ellos nadie mas puede entrenar -- el unico
# dataset completo sale de los 133 PDFs reales, que no salen de la maquina.
# Verificado antes de versionarlos: no contienen ningun dato del cliente.
!data/faq/faq_demo-publica.json
!data/faq/faq_demo-publica.md
!data/faq/faq_demo-publica_rechazos.md
!data/finetune/demo-publica/

# Adaptadores LoRA y modelos fusionados: se entrenan sobre ese mismo contenido.
adapters/
models/
*.safetensors
*.gguf

# Lo que SI se versiona: el corpus sintetico de demo, para que el proyecto se
# pueda clonar y ejecutar de punta a punta sin datos de ningun cliente.
# Lo genera scripts/generate_demo_corpus.py y no contiene informacion real.
!data/knowledge_base/demo-publica/
!data/knowledge_base/demo-publica/**
!data/knowledge_base/*/.gitkeep
!data/knowledge_base/*/metadata.csv.ejemplo

# Notas personales de la exposicion: no forman parte del proyecto.
docs/guion-*.md
docs/guion-*.html

# Mockups de referencia de marcas de terceros: no se redistribuyen. El logo de
# ABISERVI si viaja: es la marca del cliente y hace falta para su dataset de imagen.
data/marca/mockups/

# El arte sin componer: util para reencuadrar sin volver a generar, pero es el
# doble de peso y la pieza terminada ya esta versionada.
docs/imagenes/crudo/

# La comparacion corrida sobre el tenant REAL reproduce contenido de sus
# clausulas en las respuestas del modelo: plazos, responsables, codigos. Mismo
# criterio que los PDFs y que el FAQ. La version de `demo-publica` si viaja.
docs/comparacion-lora.json
docs/comparacion-lora.md

# Lo mismo para la comparacion de tres estados. Su DETALLE lleva las respuestas
# literales; los porcentajes y los codigos inventados que la presentacion usa no
# son datos de cliente -- un codigo inventado no existe en ningun SGC.
docs/tres-estados-*.json
docs/tres-estados-*.md
!docs/tres-estados-demo-publica.json
!docs/tres-estados-demo-publica.md

# La ablacion del prompt, como las demas: el detalle lleva respuestas literales.
docs/valor-lora-*.json
docs/valor-lora-*.md
!docs/valor-lora-demo-publica.json
!docs/valor-lora-demo-publica.md

# El dataset empaquetado para el notebook lleva el texto de las clausulas
# reales, igual que el de data/finetune. Se regenera con
# scripts/exportar_dataset_notebook.py.
notebooks/normia_dataset.jsonl

# Copias locales de entrega: llevan el dataset con el texto de las clausulas reales.
entrega/
.playwright-mcp/
